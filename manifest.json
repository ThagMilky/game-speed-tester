{
  "manifest_version": 3,
  "name": "Game Speed Tester",
  "version": "1.0.0",
  "description": "Local movement-speed override for authorized testing on nghichthienky.online.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://nghichthienky.online/*"],
      "js": ["harvest-main-options.js", "farm-update.js", "farm-input.js", "page.js", "farm-page.js", "farm-diagnostics.js", "farm-session.js", "farm-seals.js", "realm-page.js", "harvest-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://nghichthienky.online/*"],
      "js": ["harvest-options.js", "content.js", "font-options.js", "font.js", "farm-content.js", "farm-diagnostics-content.js", "harvest-content.js", "realm-content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
