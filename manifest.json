{
  "manifest_version": 3,
  "name": "Game Speed Tester",
  "version": "1.0.0",
  "description": "Local movement-speed override for authorized testing on nghichthienky.online.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "web_accessible_resources": [{ "resources": ["popup.html"], "matches": ["https://nghichthienky.online/*"] }],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://nghichthienky.online/*"],
      "js": ["harvest-main-options.js", "farm-update.js", "navigation.js", "farm-revive-policy.js", "farm-input.js", "farm-behavior.js", "farm-map.js", "page.js", "farm-page.js", "farm-diagnostics.js", "farm-session.js", "farm-seals.js", "realm-page.js", "harvest-page.js", "fps-map.js", "fps-page.js", "realm-time-page.js", "chest-page.js", "background-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://nghichthienky.online/*"],
      "js": ["harvest-options.js", "content.js", "font-options.js", "font.js", "farm-content.js", "farm-diagnostics-content.js", "harvest-content.js", "realm-content.js", "fps-options.js", "fps-content.js", "realm-time-content.js", "chest-content.js", "menu-position.js", "game-menu.js", "background-content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
