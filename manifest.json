{
  "manifest_version": 3,
  "name": "Game Speed Tester",
  "version": "1.0.2",
  "description": "Local movement-speed override for authorized testing on nghichthienky.online.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html"
      ],
      "matches": [
        "https://nghichthienky.online/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nghichthienky.online/*"
      ],
      "js": [
        "features/automation/auto-harvest/harvest-main-options.js",
        "shared/diagnostics/background-diagnostics.js",
        "shared/diagnostics/movement-log-schema.js",
        "shared/diagnostics/movement-diagnostics.js",
        "shared/coordination/farm-update.js",
        "features/automation/auto-potion/potion-page.js",
        "features/automation/auto-farm/farm-combat.js",
        "shared/navigation/navigation.js",
        "shared/coordination/farm-revive-policy.js",
        "features/automation/auto-farm/farm-compatibility-main.js",
        "features/automation/auto-farm/farm-policy-main.js",
        "shared/navigation/farm-input.js",
        "features/movement/map/map-travel-page.js",
        "shared/navigation/farm-routing.js",
        "features/movement/flight/flight-page.js",
        "features/movement/meditation/meditation-page.js",
        "features/automation/auto-farm/farm-behavior.js",
        "features/automation/auto-farm/farm-defense.js",
        "features/automation/auto-farm/farm-encounter.js",
        "features/automation/auto-farm/farm-monster-classification.js",
        "features/automation/auto-farm/farm-boss-safety.js",
        "features/automation/auto-farm/farm-map.js",
        "features/automation/auto-farm/farm-visual.js",
        "features/movement/map/area-map-page.js",
        "core/page.js",
        "features/automation/auto-farm/farm-page.js",
        "shared/diagnostics/farm-diagnostics.js",
        "features/automation/auto-farm/farm-session.js",
        "features/automation/auto-farm/farm-seals.js",
        "features/automation/auto-realm/realm-history.js",
        "features/automation/auto-realm/realm-page.js",
        "features/automation/auto-harvest/harvest-visual.js",
        "features/automation/auto-harvest/harvest-page.js",
        "features/automation/auto-reconnect/reconnect-page.js",
        "features/visual/fps/fps-map.js",
        "features/visual/fps/fps-minimap.js",
        "features/visual/fps/fps-minimap-zoom.js",
        "features/visual/fps/fps-minimap-colors.js",
        "features/visual/fps/fps-page.js",
        "features/automation/auto-realm/realm-time-page.js",
        "features/automation/auto-chest/chest-page.js",
        "features/visual/background/background-page.js",
        "features/automation/auto-quest/quest-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://nghichthienky.online/*"
      ],
      "js": [
        "features/automation/auto-harvest/harvest-options.js",
        "core/content.js",
        "ui/interface/game-panel-scroll.js",
        "ui/interface/font-options.js",
        "ui/interface/font.js",
        "features/automation/auto-potion/potion-content.js",
        "features/automation/auto-farm/farm-policy.js",
        "features/automation/auto-farm/farm-content.js",
        "shared/diagnostics/movement-log-schema.js",
        "shared/diagnostics/farm-diagnostics-content.js",
        "features/automation/auto-harvest/harvest-content.js",
        "features/automation/auto-realm/realm-content.js",
        "features/automation/auto-realm/realm-history-content.js",
        "features/visual/fps/fps-options.js",
        "features/visual/fps/fps-content.js",
        "features/automation/auto-realm/realm-time-content.js",
        "features/automation/auto-chest/chest-content.js",
        "ui/game-menu/menu-position.js",
        "ui/game-menu/game-menu.js",
        "features/movement/map/area-map-content.js",
        "features/visual/background/background-content.js",
        "features/automation/auto-quest/quest-content.js",
        "features/movement/flight/flight-content.js",
        "features/movement/meditation/meditation-content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
